{
  "name": "running",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config tests/vitest.config.ts --exclude tests/integration/**/*.test.ts",
    "test:integration": "prisma migrate deploy && vitest run --config tests/vitest.config.ts tests/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@prisma/client": "^6.17.0",
    "nuxt": "^3.13.2",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.12"
  }
}

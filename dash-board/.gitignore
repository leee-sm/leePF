# 원본 SSO 구현을 참고하기 위한 별도 clone. 현재 프로젝트 산출물에는 포함하지 않는다.
/security-portal-admin/
/.env

# Python 로컬 실행 산출물
backend/.venv/
backend/.env
backend/poc.db
backend/*.egg-info/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/*
!frontend/test-results/.gitkeep
__pycache__/
*.py[cod]

# Local IDE and packaged offline artifacts
.idea/
/.gitlab-backup/
/dist-offline/

# Local offline deployment secrets
/docker/offline/.env
/docker/offline/deploy.conf

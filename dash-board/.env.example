# `cp .env.example .env` before docker compose up.
APP_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=
HOST_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Optional PEM bundle for Docker builds behind a TLS-inspecting proxy.
BUILD_CA_CERT_FILE=

POSTGRES_DB=ax_distribution
POSTGRES_USER=ax_distribution
POSTGRES_PASSWORD=local-only-change-this

# Development PC demo: set APP_ENV=development, SSO_ENABLED=false,
# DEV_AUTO_LOGIN=true, and SSO_BOOTSTRAP_ADMIN_SABUN=2210013.
SSO_ENABLED=true
SSO_URI=https://sso-hub.ktis.co.kr
SSO_EXCHANGE_BASE_URI=http://localhost:8630
SSO_LOGIN_URL=/slogin
SSO_EXCHANGE_URL=/api/ott/exchange
SSO_LOGOUT_URL=/slogout
SSO_TOKEN_PARAM=ssoToken
SSO_RETURN_PARAM=returnUrl
SSO_CALLBACK_PATH=/sso/callback
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
DEV_AUTO_LOGIN=false
DEV_AUTO_LOGIN_SABUN=2210013
DEV_AUTO_LOGIN_USER_SABUN=2210014
SSO_BOOTSTRAP_ADMIN_SABUN=
